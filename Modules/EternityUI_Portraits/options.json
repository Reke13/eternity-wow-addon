{
  "format": 1,
  "module": "EternityUI_Portraits",
  "title": { "enUS": "Portraits", "esES": "Retratos" },
  "description": {
    "enUS": "A theme's class portraits over Blizzard's unit frames. Turn them on in Appearance.",
    "esES": "Los retratos por clase de un tema sobre los marcos de Blizzard. Actívalos en Apariencia."
  },
  "groups": [
    {
      "id": "look",
      "label": { "enUS": "Look", "esES": "Aspecto" },
      "options": [
        {
          "id": "scale",
          "type": "range",
          "default": 1.3,
          "min": 1,
          "max": 1.8,
          "step": 0.05,
          "label": { "enUS": "Size over the portrait", "esES": "Tamaño sobre el retrato" }
        }
      ]
    }
  ]
}
