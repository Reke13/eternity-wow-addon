-- Locked slots: they're remembered per slot, and the sort's plan never moves them.
import test, expect from "wowlua:test"

local NAME = "EternityUI_Bags"

local function locks()
    return EternityUI:GetModule(NAME).locks
end

-- A slot of the plan: bag 0, slot n, an item (link, quality, class...) or nil.
local function slot(n, link, extra)
    local item
    if link then
        item = { id = n, link = link, count = 1, maxStack = 1, quality = 2, class = 0, subclass = 0, level = 1, name = link }
        for k, v in pairs(extra or {}) do
            item[k] = v
        end
    end
    return { bag = 0, slot = n, item = item }
end

-- Plays the plan's moves until it's done; returns the links in slot order (false = empty).
local function play(slots, reverse)
    for _ = 1, 50 do
        local move = locks().NextMove(slots, reverse)
        if not move then
            break
        end
        move.from.item, move.to.item = move.to.item, move.from.item
    end
    local links = {}
    for i, s in ipairs(slots) do
        links[i] = s.item and s.item.link or false
    end
    return links
end

@test("a slot is locked and unlocked with a click")
local function toggle()
    local l = locks()
    expect(l.Is(0, 3)).toBe(false)
    expect(l.Toggle(0, 3)).toBe(true)
    expect(l.Is(0, 3)).toBe(true)
    expect(l.Any({ 0, 1 })).toBe(true)
    expect(l.Any({ 1, 2 })).toBe(false)
    expect(l.Toggle(0, 3)).toBe(false)
    expect(l.Is(0, 3)).toBe(false)
end

@test("the sort orders by name and leaves a locked slot where it is")
local function aroundLocked()
    local slots = { slot(1, "c"), slot(2, "z"), slot(3, nil), slot(4, "a"), slot(5, "b") }
    slots[2].locked = true
    local links = play(slots)
    expect(links[1]).toBe("a")
    expect(links[2]).toBe("z")
    expect(links[3]).toBe("b")
    expect(links[4]).toBe("c")
    expect(links[5]).toBe(false)
end

@test("an empty locked slot stays empty")
local function emptyLocked()
    local slots = { slot(1, nil), slot(2, "b"), slot(3, "a") }
    slots[1].locked = true
    local links = play(slots)
    expect(links[1]).toBe(false)
    expect(links[2]).toBe("a")
    expect(links[3]).toBe("b")
end

@test("junk goes last and reverse fills from the end")
local function junkAndReverse()
    local slots = { slot(1, "junk", { quality = 0 }), slot(2, "b"), slot(3, nil) }
    local links = play(slots)
    expect(links[1]).toBe("b")
    expect(links[2]).toBe("junk")
    slots = { slot(1, "b"), slot(2, nil), slot(3, "a") }
    links = play(slots, true)
    expect(links[3]).toBe("a")
    expect(links[2]).toBe("b")
    expect(links[1]).toBe(false)
end

@test("partial stacks of the same item are merged first")
local function merges()
    local slots = {
        slot(1, "arrow", { count = 50, maxStack = 200 }),
        slot(2, "x"),
        slot(3, "arrow", { count = 30, maxStack = 200 }),
    }
    local move = locks().NextMove(slots)
    expect(move.from.slot).toBe(3)
    expect(move.to.slot).toBe(1)
end

@test("the padlock turns lock mode on and off, and closing the window ends it")
local function lockMode()
    OpenAllBags()
    local grid = EternityUI:GetModule(NAME).bags
    expect(grid.lock:IsShown()).toBe(true)
    grid.lock:Click()
    expect(grid.lockMode).toBe(true)
    expect(grid.lockLayer:IsShown()).toBe(true)
    grid.lock:Click()
    expect(grid.lockMode).toBe(false)
    expect(grid.lockLayer:IsShown()).toBe(false)
    grid.lock:Click()
    CloseAllWindows()
    expect(grid.lockMode).toBe(false)
end

@test("a locked slot shows its padlock")
local function marker()
    OpenAllBags()
    local module = EternityUI:GetModule(NAME)
    local grid = module.bags
    module.locks.Toggle(0, 1)
    grid:Refresh()
    local b = grid.buttons[0] and grid.buttons[0][1]
    expect(b ~= nil and b.etLock:IsShown()).toBe(true)
    module.locks.Toggle(0, 1)
    grid:Refresh()
    expect(b.etLock:IsShown()).toBe(false)
    CloseAllWindows()
end
