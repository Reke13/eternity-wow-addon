-- The saved view: the bank from anywhere, another character's bank and the guild bank, from what
-- EternityUIBagsDB keeps, in a window built like the real bank's.
import test, expect from "wowlua:test"

local NAME = "EternityUI_Bags"

local function module()
    return EternityUI:GetModule(NAME)
end

-- A second character with bags, bank and a guild, saved as Inventory saves them.
local function seed()
    local inventory = module().inventory
    local db = inventory:Bind()
    local realm = inventory.Me()
    db.realms[realm] = db.realms[realm] or {}
    db.realms[realm]["Alt"] = {
        class = "MAGE",
        money = 1234567,
        updated = time() - 7200,
        bankUpdated = time() - 90000,
        guild = realm .. "/Sample Guild",
        bags = { [6948] = 1 },
        bank = { [2589] = 20 },
        equipped = {},
        layout = {
            bags = { { id = 0, kind = "backpack", size = 16, slots = { [1] = { 6948, 1 } } } },
            bank = { { id = 6, kind = "tab", name = "Tab 1", size = 98, slots = { [3] = { 2589, 20 } } } },
        },
    }
    db.guilds[realm .. "/Sample Guild"] = {
        name = "Sample Guild",
        realm = realm,
        updated = time() - 30,
        tabs = { { id = 1, index = 1, kind = "guild", name = "Mats", size = 98, slots = { [1] = { 2589, 200 } } } },
    }
    return realm
end

@test("every saved character is listed, this one first")
local function characters()
    local realm = seed()
    local list = module().inventory:Characters()
    expect(#list >= 1).toBe(true)
    local found = false
    for i, char in ipairs(list) do
        if char.current then
            expect(i).toBe(1)
        end
        if char.realm == realm and char.name == "Alt" then
            found = true
            expect(char.class).toBe("MAGE")
        end
    end
    expect(found).toBe(true)
end

@test("each place gives its containers and when they were saved")
local function places()
    local realm = seed()
    local viewer = module().viewer
    local bank, updated = viewer.Containers("bank", realm, "Alt")
    expect(updated ~= nil).toBe(true)
    expect(bank[1].slots[3][2]).toBe(20)
    local guild = viewer.Containers("guild", realm, "Alt")
    expect(guild[1].name).toBe("Mats")
    expect(guild[1].slots[1][2]).toBe(200)
end

@test("a place with nothing saved says why")
local function missing()
    local realm = seed()
    local db = module().inventory:Bind()
    db.realms[realm]["Fresh"] = { bags = {}, bank = {}, equipped = {} }
    local viewer = module().viewer
    local list, updated, why = viewer.Containers("bank", realm, "Fresh")
    expect(#list).toBe(0)
    expect(updated == nil).toBe(true)
    expect(type(why)).toBe("string")
    local _, _, noGuild = viewer.Containers("guild", realm, "Fresh")
    expect(type(noGuild)).toBe("string")
end

@test("times read as minutes, hours and days ago")
local function ago()
    local viewer = module().viewer
    expect(viewer.Ago(nil) == nil).toBe(true)
    expect(viewer.Ago(1000, 1030) ~= nil).toBe(true)
    expect(viewer.Ago(1000, 1000 + 7200):find("2", 1, true) ~= nil).toBe(true)
    expect(viewer.Ago(1000, 1000 + 3 * 86400):find("3", 1, true) ~= nil).toBe(true)
end

local function shownSlots(grid)
    local shown = 0
    for _, b in ipairs(grid.savedButtons) do
        if b:IsShown() then
            shown = shown + 1
        end
    end
    return shown
end

@test("the saved bank opens in a bank window, already drawn, on another character")
local function opens()
    local realm = seed()
    module().viewer.Open("bank", realm, "Alt")
    local grid = module().saved
    expect(grid.kind).toBe("saved")
    expect(grid.frame:IsShown()).toBe(true)
    expect(grid.dirty).toBe(false)
    expect(shownSlots(grid)).toBe(98)
    expect(grid.savedButtons[3].itemID).toBe(2589)
    expect(grid.sort:IsShown()).toBe(false)
    expect(grid.character.label:GetText():find("Alt", 1, true) ~= nil).toBe(true)
    -- The guild tab of the same window.
    grid.tabs.buttons[2]:Click()
    expect(grid.place).toBe("guild")
    expect(grid.savedButtons[1].itemID).toBe(2589)
    grid.frame:Hide()
end

local function realShown(grid)
    local shown = 0
    for _, list in pairs(grid.buttons) do
        for _, b in pairs(list) do
            if b:IsShown() then
                shown = shown + 1
            end
        end
    end
    return shown
end

@test("the bags window switches to another character's bags and back")
local function bagsOf()
    local realm = seed()
    OpenAllBags()
    local grid = module().bags
    expect(grid.others ~= nil).toBe(true)
    expect(grid.savedBank ~= nil).toBe(true)
    local own = realShown(grid)
    grid:ViewCharacter(realm, "Alt")
    expect(grid:IsSaved()).toBe(true)
    expect(realShown(grid)).toBe(0)
    expect(shownSlots(grid)).toBe(16)
    expect(grid.savedButtons[1].itemID).toBe(6948)
    expect(grid.others.label:GetText():find("Alt", 1, true) ~= nil).toBe(true)
    -- Its gold, as saved.
    expect(grid.money:GetText()).toBe(GetMoneyString(1234567, true))
    expect(grid.frame:GetWidth() >= grid:FooterWidth() - 1).toBe(true)
    -- Picking this character goes back to the real bags.
    grid:ViewCharacter(module().inventory.Me())
    expect(grid:IsSaved()).toBe(false)
    expect(shownSlots(grid)).toBe(0)
    expect(realShown(grid)).toBe(own)
    -- Closing the bags forgets the other character.
    grid:ViewCharacter(realm, "Alt")
    CloseAllWindows()
    expect(grid.viewing == nil).toBe(true)
end

@test("the gold of every character is listed, richest first, with the total")
local function gold()
    local realm = seed()
    local inventory = module().inventory
    inventory:ScanMoney()
    local list, total = inventory:MoneyList()
    expect(#list >= 2).toBe(true)
    local sum = 0
    for i, char in ipairs(list) do
        sum = sum + char.money
        if i > 1 then
            expect(list[i - 1].money >= char.money).toBe(true)
        end
    end
    expect(total).toBe(sum)
    local found = false
    for _, char in ipairs(list) do
        found = found or (char.realm == realm and char.name == "Alt" and char.money == 1234567)
    end
    expect(found).toBe(true)
end

@test("the guild items are kept while a guild remembers them")
local function prune()
    seed()
    local inventory = module().inventory
    local db = inventory:Bind()
    db.items[999999] = { name = "Only in the guild" }
    db.guilds["x/Other"] = { name = "Other", realm = "x", tabs = { { size = 98, slots = { [1] = { 999999, 1 } } } } }
    inventory:PruneItems()
    expect(db.items[999999] ~= nil).toBe(true)
    db.guilds["x/Other"] = nil
    inventory:PruneItems()
    expect(db.items[999999] == nil).toBe(true)
end
