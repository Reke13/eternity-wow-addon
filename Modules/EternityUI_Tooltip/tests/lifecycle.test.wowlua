-- The module starts and stops cleanly.
import test, expect from "wowlua:test"

local NAME = "EternityUI_Tooltip"

@test("the module starts")
local function starts()
    expect(EternityUI:GetModule(NAME).active).toBe(true)
end

@test("the module stops and starts again")
local function cycle()
    EternityUI.store:SetModuleEnabled(NAME, false)
    expect(EternityUI:GetModule(NAME).active).toBe(false)
    EternityUI.store:SetModuleEnabled(NAME, true)
    expect(EternityUI:GetModule(NAME).active).toBe(true)
end

@test("creature GUIDs give their NPC ID; players and secrets give none")
local function npcIds()
    local tooltip = EternityUI:GetModule("EternityUI_Tooltip")
    expect(tooltip.NpcID("Creature-0-1465-0-12-2589-0000ABCDEF")).toBe(2589)
    expect(tooltip.NpcID("Vehicle-0-1465-0-12-33113-0000ABCDEF")).toBe(33113)
    expect(tooltip.NpcID("Player-1305-0A1B2C3D") == nil).toBe(true)
    expect(tooltip.NpcID(nil) == nil).toBe(true)
end
