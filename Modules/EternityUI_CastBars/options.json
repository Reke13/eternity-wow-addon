{
  "format": 1,
  "module": "EternityUI_CastBars",
  "title": { "enUS": "Cast Bars", "esES": "Barras de lanzamiento" },
  "description": {
    "enUS": "Cast bars for you, your target, focus, pet, bosses and arena; GCD and breath timers. Move them with /etmove.",
    "esES": "Barras de lanzamiento para ti, objetivo, foco, mascota, jefes y arena; GCD y respiración. Muévelas con /etmove."
  },
  "groups": [
    {
      "id": "bars",
      "label": { "enUS": "Bars", "esES": "Barras" },
      "options": [
        {
          "id": "player",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Player", "esES": "Jugador" }
        },
        {
          "id": "target",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Target", "esES": "Objetivo" }
        },
        {
          "id": "focus",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Focus", "esES": "Foco" }
        },
        {
          "id": "pet",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Pet", "esES": "Mascota" }
        },
        {
          "id": "boss",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Bosses (1-5)", "esES": "Jefes (1-5)" }
        },
        {
          "id": "arena",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Arena enemies (1-5)", "esES": "Enemigos de arena (1-5)" }
        },
        {
          "id": "gcd",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Global cooldown", "esES": "Tiempo de reutilización global" }
        },
        {
          "id": "mirror",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Breath, fatigue and feign death", "esES": "Respiración, fatiga y fingir muerte" }
        }
      ]
    },
    {
      "id": "blizzard",
      "label": { "enUS": "Blizzard's cast bars", "esES": "Barras de Blizzard" },
      "description": {
        "enUS": "Hidden while the module is on and given back when it's off. In combat the change waits until it ends.",
        "esES": "Se ocultan mientras el módulo está activo y vuelven al desactivarlo. En combate el cambio espera a que acabe."
      },
      "options": [
        {
          "id": "player",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide the player's", "esES": "Ocultar la del jugador" }
        },
        {
          "id": "target",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide the target's", "esES": "Ocultar la del objetivo" }
        },
        {
          "id": "focus",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide the focus'", "esES": "Ocultar la del foco" }
        },
        {
          "id": "pet",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide the pet's", "esES": "Ocultar la de la mascota" }
        },
        {
          "id": "boss",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide the bosses'", "esES": "Ocultar las de los jefes" }
        },
        {
          "id": "arena",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide the arena enemies'", "esES": "Ocultar las de los enemigos de arena" }
        },
        {
          "id": "mirror",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hide breath and fatigue", "esES": "Ocultar respiración y fatiga" }
        }
      ]
    },
    {
      "id": "gcd",
      "label": { "enUS": "Global cooldown", "esES": "Tiempo de reutilización global" },
      "options": [
        {
          "id": "attach",
          "type": "select",
          "default": "below",
          "label": { "enUS": "Place", "esES": "Posición" },
          "description": {
            "enUS": "Under or over your cast bar (it follows it), or free to move with /etmove.",
            "esES": "Debajo o encima de tu barra de lanzamiento (la sigue), o suelta para moverla con /etmove."
          },
          "values": [
            { "value": "below", "label": { "enUS": "Under the player's bar", "esES": "Debajo de la del jugador" } },
            { "value": "above", "label": { "enUS": "Over the player's bar", "esES": "Encima de la del jugador" } },
            { "value": "free", "label": { "enUS": "Free (Edit Mode)", "esES": "Suelta (modo edición)" } }
          ]
        },
        {
          "id": "gap",
          "type": "range",
          "default": 2,
          "min": 0,
          "max": 20,
          "step": 1,
          "label": { "enUS": "Gap to the player's bar", "esES": "Separación de la del jugador" }
        }
      ]
    },
    {
      "id": "groups",
      "label": { "enUS": "Bosses and arena", "esES": "Jefes y arena" },
      "options": [
        {
          "id": "grow",
          "type": "select",
          "default": "down",
          "label": { "enUS": "Stack", "esES": "Apilar" },
          "values": [
            { "value": "down", "label": { "enUS": "Downwards", "esES": "Hacia abajo" } },
            { "value": "up", "label": { "enUS": "Upwards", "esES": "Hacia arriba" } }
          ]
        },
        { "id": "spacing", "type": "range", "default": 6, "min": 0, "max": 30, "step": 1, "label": { "enUS": "Spacing", "esES": "Separación" } }
      ]
    },
    {
      "id": "player",
      "label": { "enUS": "Player bar", "esES": "Barra del jugador" },
      "options": [
        {
          "id": "latency",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show latency", "esES": "Mostrar la latencia" },
          "description": {
            "enUS": "The end of the cast you can already queue the next spell in (world latency).",
            "esES": "El final del lanzamiento en el que ya puedes encolar el siguiente hechizo (latencia del mundo)."
          }
        },
        {
          "id": "ticks",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show channel ticks", "esES": "Mostrar los ticks del canalizado" }
        },
        {
          "id": "tickList",
          "type": "text",
          "default": "234153=5, 15407=6, 5143=5, 47540=3, 257044=7, 113656=5, 117952=4, 356995=4, 740=4",
          "maxLength": 255,
          "label": { "enUS": "Ticks per channel", "esES": "Ticks por canalizado" },
          "description": {
            "enUS": "spellID=ticks, separated by commas.",
            "esES": "spellID=ticks, separados por comas."
          }
        },
        {
          "id": "stages",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show empower stages", "esES": "Mostrar las etapas potenciadas" }
        },
        {
          "id": "spellTarget",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Show the spell's target", "esES": "Mostrar el objetivo del hechizo" },
          "description": {
            "enUS": "Adds who you're casting at after the spell's name.",
            "esES": "Añade a quién lanzas el hechizo tras su nombre."
          }
        }
      ]
    },
    {
      "id": "behavior",
      "label": { "enUS": "Behavior", "esES": "Comportamiento" },
      "options": [
        {
          "id": "name",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show the spell's name", "esES": "Mostrar el nombre del hechizo" }
        },
        {
          "id": "time",
          "type": "select",
          "default": "remaining",
          "label": { "enUS": "Time text", "esES": "Texto de tiempo" },
          "values": [
            { "value": "remaining", "label": { "enUS": "Time left", "esES": "Tiempo restante" } },
            { "value": "both", "label": { "enUS": "Time left / total", "esES": "Restante / total" } },
            { "value": "none", "label": { "enUS": "None", "esES": "Ninguno" } }
          ]
        },
        {
          "id": "interruptedBy",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show who interrupted", "esES": "Mostrar quién interrumpió" },
          "description": {
            "enUS": "Only when the game tells addons (it can be secret).",
            "esES": "Solo cuando el juego se lo dice a los addons (puede ser secreto)."
          }
        },
        {
          "id": "tradeskill",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show profession casts", "esES": "Mostrar lanzamientos de profesión" }
        },
        {
          "id": "hold",
          "type": "range",
          "default": 1,
          "min": 0,
          "max": 3,
          "step": 0.1,
          "label": { "enUS": "Keep failed casts (seconds)", "esES": "Mantener los fallidos (segundos)" }
        },
        {
          "id": "fade",
          "type": "range",
          "default": 0.3,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Fade out (seconds)", "esES": "Desvanecer (segundos)" }
        }
      ]
    },
    {
      "id": "layout",
      "tab": "appearance",
      "label": { "enUS": "Size", "esES": "Tamaño" },
      "options": [
        { "id": "playerWidth", "type": "range", "default": 280, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Player: width", "esES": "Jugador: ancho" } },
        { "id": "playerHeight", "type": "range", "default": 24, "min": 8, "max": 60, "step": 1, "label": { "enUS": "Player: height", "esES": "Jugador: alto" } },
        { "id": "targetWidth", "type": "range", "default": 240, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Target: width", "esES": "Objetivo: ancho" } },
        { "id": "targetHeight", "type": "range", "default": 20, "min": 8, "max": 60, "step": 1, "label": { "enUS": "Target: height", "esES": "Objetivo: alto" } },
        { "id": "focusWidth", "type": "range", "default": 220, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Focus: width", "esES": "Foco: ancho" } },
        { "id": "focusHeight", "type": "range", "default": 18, "min": 8, "max": 60, "step": 1, "label": { "enUS": "Focus: height", "esES": "Foco: alto" } },
        { "id": "petWidth", "type": "range", "default": 180, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Pet: width", "esES": "Mascota: ancho" } },
        { "id": "petHeight", "type": "range", "default": 16, "min": 8, "max": 60, "step": 1, "label": { "enUS": "Pet: height", "esES": "Mascota: alto" } },
        { "id": "bossWidth", "type": "range", "default": 200, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Bosses: width", "esES": "Jefes: ancho" } },
        { "id": "bossHeight", "type": "range", "default": 18, "min": 8, "max": 60, "step": 1, "label": { "enUS": "Bosses: height", "esES": "Jefes: alto" } },
        { "id": "arenaWidth", "type": "range", "default": 200, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Arena: width", "esES": "Arena: ancho" } },
        { "id": "arenaHeight", "type": "range", "default": 18, "min": 8, "max": 60, "step": 1, "label": { "enUS": "Arena: height", "esES": "Arena: alto" } },
        { "id": "gcdWidth", "type": "range", "default": 280, "min": 40, "max": 800, "step": 2, "label": { "enUS": "Global cooldown: width (free)", "esES": "Reutilización global: ancho (suelta)" }, "visibleWhen": { "gcd.attach": "free" } },
        { "id": "gcdHeight", "type": "range", "default": 6, "min": 2, "max": 40, "step": 1, "label": { "enUS": "Global cooldown: height", "esES": "Reutilización global: alto" } },
        { "id": "mirrorWidth", "type": "range", "default": 220, "min": 80, "max": 800, "step": 2, "label": { "enUS": "Breath and fatigue: width", "esES": "Respiración y fatiga: ancho" } },
        { "id": "mirrorHeight", "type": "range", "default": 18, "min": 8, "max": 40, "step": 1, "label": { "enUS": "Breath and fatigue: height", "esES": "Respiración y fatiga: alto" } },
        { "id": "scale", "type": "range", "default": 1, "min": 0.6, "max": 2, "step": 0.05, "label": { "enUS": "Scale", "esES": "Escala" } }
      ]
    },
    {
      "id": "look",
      "tab": "appearance",
      "label": { "enUS": "Look", "esES": "Aspecto" },
      "options": [
        {
          "id": "icon",
          "type": "select",
          "default": "left",
          "label": { "enUS": "Spell icon", "esES": "Icono del hechizo" },
          "values": [
            { "value": "left", "label": { "enUS": "Left", "esES": "Izquierda" } },
            { "value": "right", "label": { "enUS": "Right", "esES": "Derecha" } },
            { "value": "none", "label": { "enUS": "Hidden", "esES": "Oculto" } }
          ]
        },
        {
          "id": "texture",
          "type": "select",
          "default": "theme",
          "label": { "enUS": "Fill", "esES": "Relleno" },
          "values": [
            { "value": "theme", "label": { "enUS": "Like the theme (glass or flat)", "esES": "Como el tema (cristal o plano)" } },
            { "value": "flat", "label": { "enUS": "Flat", "esES": "Plano" } },
            { "value": "gradient", "label": { "enUS": "Gradient", "esES": "Degradado" } }
          ]
        },
        {
          "id": "spark",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Spark at the edge", "esES": "Chispa en el borde" }
        },
        {
          "id": "shield",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Border on uninterruptible casts", "esES": "Borde en lanzamientos no interrumpibles" }
        },
        {
          "id": "font",
          "type": "select",
          "default": "small",
          "label": { "enUS": "Text size", "esES": "Tamaño del texto" },
          "values": [
            { "value": "caption", "label": { "enUS": "Small", "esES": "Pequeño" } },
            { "value": "small", "label": { "enUS": "Medium", "esES": "Mediano" } },
            { "value": "body", "label": { "enUS": "Large", "esES": "Grande" } }
          ]
        },
        {
          "id": "background",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show the background", "esES": "Mostrar el fondo" }
        }
      ]
    },
    {
      "id": "colors",
      "tab": "appearance",
      "label": { "enUS": "Colors", "esES": "Colores" },
      "options": [
        {
          "id": "cast",
          "type": "color",
          "default": "@accent",
          "label": { "enUS": "Cast", "esES": "Lanzamiento" }
        },
        { "id": "channel", "type": "color", "default": "@accent2", "label": { "enUS": "Channel", "esES": "Canalizado" } },
        { "id": "empower", "type": "color", "default": "#F472B6", "label": { "enUS": "Empowered", "esES": "Potenciado" } },
        { "id": "locked", "type": "color", "default": "#9CA3AF", "label": { "enUS": "Uninterruptible", "esES": "No interrumpible" } },
        { "id": "success", "type": "color", "default": "#22C55E", "label": { "enUS": "Finished", "esES": "Terminado" } },
        { "id": "failed", "type": "color", "default": "#EF4444", "label": { "enUS": "Failed or interrupted", "esES": "Fallido o interrumpido" } },
        { "id": "latency", "type": "color", "default": "#EF444488", "label": { "enUS": "Latency", "esES": "Latencia" } },
        { "id": "gcd", "type": "color", "default": "@accent", "label": { "enUS": "Global cooldown", "esES": "Reutilización global" } },
        { "id": "breath", "type": "color", "default": "#3B82F6", "label": { "enUS": "Breath", "esES": "Respiración" } },
        { "id": "fatigue", "type": "color", "default": "#F59E0B", "label": { "enUS": "Fatigue", "esES": "Fatiga" } },
        { "id": "feign", "type": "color", "default": "#A78BFA", "label": { "enUS": "Feign death and others", "esES": "Fingir muerte y otros" } }
      ]
    }
  ]
}
