{
  "format": 1,
  "module": "EternityUI_Experience",
  "title": { "enUS": "Experience", "esES": "Experiencia" },
  "description": {
    "enUS": "Experience bar with rested and quest XP, projected level, XP per hour and time to level. Hover it for details; Charts shows your progress.",
    "esES": "Barra de experiencia con descanso, XP de misiones, nivel previsto, XP por hora y tiempo hasta subir. Gráficas muestra tu progreso."
  },
  "groups": [
    {
      "id": "bar",
      "label": { "enUS": "Bar", "esES": "Barra" },
      "options": [
        {
          "id": "rested",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show rested XP", "esES": "Mostrar el descanso" }
        },
        {
          "id": "questsDone",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show XP of completed quests", "esES": "Mostrar la XP de las misiones completadas" },
          "description": {
            "enUS": "What you'd gain by turning in the quests that are ready.",
            "esES": "Lo que ganarías al entregar las misiones que ya están listas."
          }
        },
        {
          "id": "questsAll",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show XP of the whole quest log", "esES": "Mostrar la XP de todo el registro" },
          "description": {
            "enUS": "What you'd gain by finishing every quest in your log.",
            "esES": "Lo que ganarías al terminar todas las misiones del registro."
          }
        },
        {
          "id": "ticks",
          "type": "range",
          "default": 10,
          "min": 0,
          "max": 20,
          "step": 1,
          "label": { "enUS": "Divisions", "esES": "Divisiones" },
          "description": { "enUS": "0 = no divisions.", "esES": "0 = sin divisiones." }
        },
        {
          "id": "textShow",
          "type": "select",
          "default": "always",
          "label": { "enUS": "Show the texts", "esES": "Mostrar los textos" },
          "values": [
            { "value": "always", "label": { "enUS": "Always", "esES": "Siempre" } },
            { "value": "hover", "label": { "enUS": "On mouseover", "esES": "Al pasar el ratón" } },
            { "value": "never", "label": { "enUS": "Never", "esES": "Nunca" } }
          ]
        },
        {
          "id": "textLeft",
          "type": "text",
          "default": "Lv {level}  {pct}",
          "maxLength": 120,
          "label": { "enUS": "Left text", "esES": "Texto izquierdo" },
          "description": {
            "enUS": "Tokens: {level} {next} {cur} {max} {pct} {rem} {rempct} {rested} {restedpct}.",
            "esES": "Marcadores: {level} {next} {cur} {max} {pct} {rem} {rempct} {rested} {restedpct}."
          }
        },
        {
          "id": "textCenter",
          "type": "text",
          "default": "{cur} / {max}",
          "maxLength": 120,
          "label": { "enUS": "Center text", "esES": "Texto central" },
          "description": {
            "enUS": "Also: {done} {quests} {proj} {rate} {eta} {kills} {gained} {session}.",
            "esES": "Además: {done} {quests} {proj} {rate} {eta} {kills} {gained} {session}."
          }
        },
        {
          "id": "textRight",
          "type": "text",
          "default": "{proj}",
          "maxLength": 120,
          "label": { "enUS": "Right text", "esES": "Texto derecho" },
          "description": { "enUS": "Any token of the left and center texts.", "esES": "Cualquier marcador de los textos izquierdo y central." }
        },
        {
          "id": "maxLevel",
          "type": "select",
          "default": "hide",
          "label": { "enUS": "At max level", "esES": "En el nivel máximo" },
          "values": [
            { "value": "hide", "label": { "enUS": "Hide the bar", "esES": "Ocultar la barra" } },
            { "value": "full", "label": { "enUS": "Show it full", "esES": "Mostrarla llena" } }
          ]
        },
        {
          "id": "hideBlizzard",
          "type": "select",
          "default": "main",
          "label": { "enUS": "Blizzard's bars", "esES": "Barras de Blizzard" },
          "description": {
            "enUS": "Blizzard's status bars (experience, reputation...). They come back when the module is disabled.",
            "esES": "Las barras de estado de Blizzard (experiencia, reputación...). Vuelven al desactivar el módulo."
          },
          "values": [
            { "value": "keep", "label": { "enUS": "Keep them", "esES": "Mantenerlas" } },
            { "value": "main", "label": { "enUS": "Hide the main one", "esES": "Ocultar la principal" } },
            { "value": "all", "label": { "enUS": "Hide both", "esES": "Ocultar las dos" } }
          ]
        }
      ]
    },
    {
      "id": "tooltip",
      "label": { "enUS": "Tooltip", "esES": "Tooltip" },
      "options": [
        {
          "id": "enabled",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show the tooltip", "esES": "Mostrar el tooltip" }
        },
        {
          "id": "progress",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Level progress", "esES": "Progreso del nivel" },
          "description": {
            "enUS": "Current and needed XP, percentage and what's left.",
            "esES": "XP actual y necesaria, porcentaje y lo que falta."
          }
        },
        {
          "id": "rested",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Rested", "esES": "Descanso" }
        },
        {
          "id": "quests",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Quests and projected level", "esES": "Misiones y nivel previsto" }
        },
        {
          "id": "session",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Session: XP gained, XP per hour, time to level", "esES": "Sesión: XP ganada, XP por hora, tiempo hasta subir" }
        },
        {
          "id": "kills",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Kills to level", "esES": "Muertes hasta subir" }
        },
        {
          "id": "time",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Time at this level and played", "esES": "Tiempo en este nivel y jugado" }
        },
        {
          "id": "hint",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Hint", "esES": "Ayuda" }
        }
      ]
    },
    {
      "id": "tracking",
      "label": { "enUS": "Tracking", "esES": "Seguimiento" },
      "options": [
        {
          "id": "rateWindow",
          "type": "select",
          "default": "session",
          "label": { "enUS": "XP per hour over", "esES": "XP por hora durante" },
          "values": [
            { "value": "session", "label": { "enUS": "The whole session", "esES": "Toda la sesión" } },
            { "value": "10", "label": { "enUS": "The last 10 minutes", "esES": "Los últimos 10 minutos" } },
            { "value": "30", "label": { "enUS": "The last 30 minutes", "esES": "Los últimos 30 minutos" } },
            { "value": "60", "label": { "enUS": "The last hour", "esES": "La última hora" } }
          ]
        },
        {
          "id": "chartBucket",
          "type": "range",
          "default": 5,
          "min": 1,
          "max": 30,
          "step": 1,
          "label": { "enUS": "Session chart: minutes per bar", "esES": "Gráfica de la sesión: minutos por barra" }
        }
      ]
    },
    {
      "id": "layout",
      "tab": "appearance",
      "label": { "enUS": "Look", "esES": "Aspecto" },
      "options": [
        {
          "id": "width",
          "type": "range",
          "default": 640,
          "min": 100,
          "max": 2560,
          "step": 10,
          "label": { "enUS": "Width", "esES": "Ancho" }
        },
        {
          "id": "height",
          "type": "range",
          "default": 14,
          "min": 4,
          "max": 40,
          "step": 1,
          "label": { "enUS": "Height", "esES": "Alto" }
        },
        {
          "id": "scale",
          "type": "range",
          "default": 1,
          "min": 0.6,
          "max": 2,
          "step": 0.05,
          "label": { "enUS": "Scale", "esES": "Escala" }
        },
        {
          "id": "font",
          "type": "select",
          "default": "caption",
          "label": { "enUS": "Text size", "esES": "Tamaño del texto" },
          "values": [
            { "value": "caption", "label": { "enUS": "Small", "esES": "Pequeño" } },
            { "value": "small", "label": { "enUS": "Medium", "esES": "Mediano" } },
            { "value": "body", "label": { "enUS": "Large", "esES": "Grande" } }
          ]
        },
        {
          "id": "background",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show the background", "esES": "Mostrar el fondo" }
        },
        {
          "id": "opacity",
          "type": "range",
          "default": 1,
          "min": 0.1,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Opacity", "esES": "Opacidad" },
          "description": {
            "enUS": "Of the whole bar: background, colors and texts.",
            "esES": "De toda la barra: fondo, colores y textos."
          }
        }
      ]
    },
    {
      "id": "colors",
      "tab": "appearance",
      "label": { "enUS": "Colors", "esES": "Colores" },
      "options": [
        {
          "id": "xp",
          "type": "color",
          "default": "@accent",
          "label": { "enUS": "Experience", "esES": "Experiencia" }
        },
        {
          "id": "rested",
          "type": "color",
          "default": "@accent2:80",
          "label": { "enUS": "Rested", "esES": "Descanso" }
        },
        {
          "id": "questsDone",
          "type": "color",
          "default": "#FBBF24CC",
          "label": { "enUS": "Completed quests", "esES": "Misiones completadas" }
        },
        {
          "id": "questsAll",
          "type": "color",
          "default": "#FBBF2455",
          "label": { "enUS": "Whole quest log", "esES": "Todo el registro" }
        }
      ]
    }
  ]
}
