{
  "format": 1,
  "module": "EternityUI_Resources",
  "title": { "enUS": "Resources", "esES": "Recursos" },
  "description": {
    "enUS": "Your mana, rage or energy as a bar that follows the druid's forms, plus combo points and the druid's mana. Move them with /etmove.",
    "esES": "Tu maná, ira o energía en una barra que sigue las formas del druida, más puntos de combo y maná del druida. Muévelas con /etmove."
  },
  "groups": [
    {
      "id": "parts",
      "label": { "enUS": "Parts", "esES": "Partes" },
      "options": [
        {
          "id": "power",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Main bar", "esES": "Barra principal" },
          "description": {
            "enUS": "The resource you're using now: energy in Cat Form, rage in Bear Form, mana otherwise.",
            "esES": "El recurso que usas ahora: energía en forma de gato, ira en forma de oso y maná en el resto."
          }
        },
        {
          "id": "combo",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Combo points", "esES": "Puntos de combo" },
          "description": {
            "enUS": "Rogues, and druids in Cat Form.",
            "esES": "Pícaros, y druidas en forma de gato."
          }
        },
        {
          "id": "druidMana",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Druid's mana while shapeshifted", "esES": "Maná del druida transformado" },
          "description": {
            "enUS": "A second, thinner bar with your mana while the main bar shows energy or rage.",
            "esES": "Una segunda barra, más fina, con tu maná mientras la principal muestra energía o ira."
          }
        }
      ]
    },
    {
      "id": "display",
      "label": { "enUS": "Behavior", "esES": "Comportamiento" },
      "options": [
        {
          "id": "visibility",
          "type": "select",
          "default": "always",
          "label": { "enUS": "Show the bars", "esES": "Mostrar las barras" },
          "values": [
            { "value": "always", "label": { "enUS": "Always", "esES": "Siempre" } },
            { "value": "target", "label": { "enUS": "In combat or with a target", "esES": "En combate o con objetivo" } },
            { "value": "combat", "label": { "enUS": "Only in combat", "esES": "Solo en combate" } }
          ]
        },
        { "id": "alphaCombat", "type": "range", "default": 1, "min": 0.1, "max": 1, "step": 0.05, "label": { "enUS": "Opacity in combat", "esES": "Opacidad en combate" } },
        { "id": "alphaIdle", "type": "range", "default": 1, "min": 0.1, "max": 1, "step": 0.05, "label": { "enUS": "Opacity out of combat", "esES": "Opacidad fuera de combate" } },
        {
          "id": "fadeAtRest",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Fade when at rest out of combat", "esES": "Atenuar en reposo fuera de combate" },
          "description": {
            "enUS": "Mana and energy rest when full, rage when empty.",
            "esES": "El maná y la energía reposan llenos, la ira vacía."
          }
        },
        {
          "id": "restAlpha",
          "type": "range",
          "default": 0.3,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Opacity at rest", "esES": "Opacidad en reposo" },
          "visibleWhen": { "display.fadeAtRest": true }
        },
        {
          "id": "comboTarget",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Combo points only with a target", "esES": "Puntos de combo solo con objetivo" }
        },
        {
          "id": "separate",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Move each part on its own", "esES": "Mover cada parte por separado" },
          "description": {
            "enUS": "Each part becomes its own element in /etmove instead of one stack.",
            "esES": "Cada parte pasa a ser un elemento propio en /etmove en lugar de una sola pila."
          }
        }
      ]
    },
    {
      "id": "layout",
      "label": { "enUS": "Size", "esES": "Tamaño" },
      "options": [
        { "id": "width", "type": "range", "default": 220, "min": 60, "max": 600, "step": 2, "label": { "enUS": "Width", "esES": "Ancho" } },
        { "id": "powerHeight", "type": "range", "default": 16, "min": 4, "max": 40, "step": 1, "label": { "enUS": "Main bar height", "esES": "Alto de la barra principal" } },
        { "id": "comboHeight", "type": "range", "default": 10, "min": 4, "max": 40, "step": 1, "label": { "enUS": "Combo points height", "esES": "Alto de los puntos de combo" } },
        { "id": "pipSpacing", "type": "range", "default": 3, "min": 0, "max": 12, "step": 1, "label": { "enUS": "Space between combo points", "esES": "Espacio entre puntos de combo" } },
        { "id": "manaHeight", "type": "range", "default": 8, "min": 2, "max": 40, "step": 1, "label": { "enUS": "Druid's mana height", "esES": "Alto del maná del druida" } },
        { "id": "spacing", "type": "range", "default": 3, "min": 0, "max": 20, "step": 1, "label": { "enUS": "Space between parts", "esES": "Espacio entre partes" } },
        {
          "id": "grow",
          "type": "select",
          "default": "down",
          "label": { "enUS": "Stack direction", "esES": "Dirección de la pila" },
          "visibleWhen": { "display.separate": false },
          "values": [
            { "value": "down", "label": { "enUS": "Down", "esES": "Hacia abajo" } },
            { "value": "up", "label": { "enUS": "Up", "esES": "Hacia arriba" } }
          ]
        },
        { "id": "scale", "type": "range", "default": 1, "min": 0.6, "max": 2, "step": 0.05, "label": { "enUS": "Scale", "esES": "Escala" } }
      ]
    },
    {
      "id": "look",
      "tab": "appearance",
      "label": { "enUS": "Look", "esES": "Aspecto" },
      "options": [
        {
          "id": "texture",
          "type": "select",
          "default": "theme",
          "label": { "enUS": "Fill", "esES": "Relleno" },
          "values": [
            { "value": "theme", "label": { "enUS": "Like the theme (glass or flat)", "esES": "Como el tema (cristal o plano)" } },
            { "value": "flat", "label": { "enUS": "Flat", "esES": "Plano" } },
            { "value": "gradient", "label": { "enUS": "Gradient", "esES": "Degradado" } }
          ]
        },
        { "id": "background", "type": "toggle", "default": true, "label": { "enUS": "Show the background", "esES": "Mostrar el fondo" } },
        {
          "id": "backgroundColor",
          "type": "color",
          "default": "@window:CC",
          "label": { "enUS": "Background color", "esES": "Color del fondo" },
          "description": {
            "enUS": "Also the color of unlit combo points.",
            "esES": "También el color de los puntos de combo apagados."
          },
          "visibleWhen": { "look.background": true }
        },
        { "id": "border", "type": "toggle", "default": true, "label": { "enUS": "Show the border", "esES": "Mostrar el borde" } },
        { "id": "borderColor", "type": "color", "default": "@border", "label": { "enUS": "Border color", "esES": "Color del borde" }, "visibleWhen": { "look.border": true } },
        {
          "id": "corners",
          "type": "select",
          "default": "theme",
          "label": { "enUS": "Corners", "esES": "Esquinas" },
          "values": [
            { "value": "theme", "label": { "enUS": "Like the theme", "esES": "Como el tema" } },
            { "value": "round", "label": { "enUS": "Round", "esES": "Redondeadas" } },
            { "value": "square", "label": { "enUS": "Square", "esES": "Rectas" } }
          ]
        },
        { "id": "spark", "type": "toggle", "default": false, "label": { "enUS": "Spark at the edge", "esES": "Chispa en el borde" } },
        {
          "id": "text",
          "type": "select",
          "default": "current",
          "label": { "enUS": "Main bar text", "esES": "Texto de la barra principal" },
          "values": [
            { "value": "current", "label": { "enUS": "Current", "esES": "Actual" } },
            { "value": "currentMax", "label": { "enUS": "Current / maximum", "esES": "Actual / máximo" } },
            { "value": "percent", "label": { "enUS": "Percent", "esES": "Porcentaje" } },
            { "value": "currentPercent", "label": { "enUS": "Current and percent", "esES": "Actual y porcentaje" } },
            { "value": "none", "label": { "enUS": "None", "esES": "Ninguno" } }
          ]
        },
        {
          "id": "manaText",
          "type": "select",
          "default": "none",
          "label": { "enUS": "Druid's mana text", "esES": "Texto del maná del druida" },
          "values": [
            { "value": "current", "label": { "enUS": "Current", "esES": "Actual" } },
            { "value": "currentMax", "label": { "enUS": "Current / maximum", "esES": "Actual / máximo" } },
            { "value": "percent", "label": { "enUS": "Percent", "esES": "Porcentaje" } },
            { "value": "currentPercent", "label": { "enUS": "Current and percent", "esES": "Actual y porcentaje" } },
            { "value": "none", "label": { "enUS": "None", "esES": "Ninguno" } }
          ]
        },
        {
          "id": "numbers",
          "type": "select",
          "default": "short",
          "label": { "enUS": "Number format", "esES": "Formato de los números" },
          "description": {
            "enUS": "How the current and maximum values are written. The percent doesn't change.",
            "esES": "Cómo se escriben el valor actual y el máximo. El porcentaje no cambia."
          },
          "values": [
            { "value": "short", "label": { "enUS": "Short (1.8K)", "esES": "Abreviado (1,8 mil)" } },
            { "value": "full", "label": { "enUS": "Full (1800)", "esES": "Completo (1800)" } },
            { "value": "separated", "label": { "enUS": "Full with separator (1,800)", "esES": "Completo con separador (1.800)" } }
          ]
        },
        {
          "id": "align",
          "type": "select",
          "default": "center",
          "label": { "enUS": "Text position", "esES": "Posición del texto" },
          "values": [
            { "value": "left", "label": { "enUS": "Left", "esES": "Izquierda" } },
            { "value": "center", "label": { "enUS": "Center", "esES": "Centro" } },
            { "value": "right", "label": { "enUS": "Right", "esES": "Derecha" } }
          ]
        },
        {
          "id": "font",
          "type": "select",
          "default": "small",
          "label": { "enUS": "Text size", "esES": "Tamaño del texto" },
          "values": [
            { "value": "caption", "label": { "enUS": "Small", "esES": "Pequeño" } },
            { "value": "small", "label": { "enUS": "Medium", "esES": "Mediano" } },
            { "value": "body", "label": { "enUS": "Large", "esES": "Grande" } }
          ]
        },
        {
          "id": "fontFamily",
          "type": "select",
          "default": "theme",
          "label": { "enUS": "Font", "esES": "Fuente" },
          "description": {
            "enUS": "The bars' typeface. \"Like the theme\" follows General > Appearance.",
            "esES": "El tipo de letra de las barras. «Como el tema» sigue General > Apariencia."
          },
          "values": [
            { "value": "theme", "label": { "enUS": "Like the theme", "esES": "Como el tema" } },
            { "value": "arialn", "label": { "enUS": "Arial Narrow", "esES": "Arial Narrow" } },
            { "value": "friz", "label": { "enUS": "Friz Quadrata", "esES": "Friz Quadrata" } },
            { "value": "morpheus", "label": { "enUS": "Morpheus", "esES": "Morpheus" } },
            { "value": "skurri", "label": { "enUS": "Skurri", "esES": "Skurri" } }
          ]
        },
        { "id": "textColor", "type": "color", "default": "#FFFFFF", "label": { "enUS": "Text color", "esES": "Color del texto" } },
        {
          "id": "outline",
          "type": "select",
          "default": "none",
          "label": { "enUS": "Text outline", "esES": "Contorno del texto" },
          "values": [
            { "value": "none", "label": { "enUS": "None (shadow)", "esES": "Ninguno (sombra)" } },
            { "value": "thin", "label": { "enUS": "Thin", "esES": "Fino" } },
            { "value": "thick", "label": { "enUS": "Thick", "esES": "Grueso" } }
          ]
        }
      ]
    },
    {
      "id": "colors",
      "tab": "appearance",
      "label": { "enUS": "Colors", "esES": "Colores" },
      "options": [
        {
          "id": "blizzard",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Blizzard's power colors", "esES": "Colores de recurso de Blizzard" },
          "description": {
            "enUS": "The game's own colors for the main bar and the druid's mana instead of the ones below.",
            "esES": "Los colores del propio juego para la barra principal y el maná del druida en lugar de los de abajo."
          }
        },
        { "id": "mana", "type": "color", "default": "#3B82F6", "label": { "enUS": "Mana", "esES": "Maná" }, "visibleWhen": { "colors.blizzard": false } },
        { "id": "rage", "type": "color", "default": "#EF4444", "label": { "enUS": "Rage", "esES": "Ira" }, "visibleWhen": { "colors.blizzard": false } },
        { "id": "energy", "type": "color", "default": "#FACC15", "label": { "enUS": "Energy", "esES": "Energía" }, "visibleWhen": { "colors.blizzard": false } },
        { "id": "focus", "type": "color", "default": "#F97316", "label": { "enUS": "Focus", "esES": "Enfoque" }, "visibleWhen": { "colors.blizzard": false } },
        { "id": "other", "type": "color", "default": "#A78BFA", "label": { "enUS": "Other resources", "esES": "Otros recursos" }, "visibleWhen": { "colors.blizzard": false } },
        { "id": "druidMana", "type": "color", "default": "#60A5FA", "label": { "enUS": "Druid's mana", "esES": "Maná del druida" }, "visibleWhen": { "colors.blizzard": false } },
        { "id": "combo", "type": "color", "default": "#F59E0B", "label": { "enUS": "Combo points", "esES": "Puntos de combo" } },
        {
          "id": "comboFull",
          "type": "color",
          "default": "#EF4444",
          "label": { "enUS": "Combo points at maximum", "esES": "Puntos de combo al máximo" },
          "description": {
            "enUS": "Only while the game lets addons read the count.",
            "esES": "Solo mientras el juego deja leer la cuenta a los addons."
          }
        }
      ]
    }
  ]
}
