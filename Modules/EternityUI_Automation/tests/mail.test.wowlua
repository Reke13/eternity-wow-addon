-- Mail: the recipient stays after sending while the option is on.
import test, expect from "wowlua:test"

local NAME = "EternityUI_Automation"

local function feature()
    return EternityUI:GetModule(NAME).Core.byId.keepRecipient
end

local function set(value)
    EternityUI.store:Set(NAME, "mail.keepRecipient", value)
end

@test("the mail recipient stays after sending, and is forgotten when the mailbox closes")
local function keepRecipient()
    set(true)
    if not SendMailFrame_Reset and C_AddOns and C_AddOns.LoadAddOn then
        C_AddOns.LoadAddOn("Blizzard_MailFrame")
    end
    local f = feature()
    expect(f.on).toBe(true)
    f:OnEvent("MAIL_SHOW")
    expect(SendMailNameEditBox ~= nil and SendMailFrame_Reset ~= nil).toBe(true)
    pcall(SendMail, "Zokk", "Hola", "")
    expect(f.last).toBe("Zokk")
    SendMailFrame_Reset()
    expect(SendMailNameEditBox:GetText()).toBe("Zokk")
    f:OnEvent("MAIL_CLOSED")
    SendMailFrame_Reset()
    expect(SendMailNameEditBox:GetText()).toBe("")
end

@test("with the option off the form is emptied as Blizzard does")
local function recipientOff()
    set(false)
    local f = feature()
    expect(f.on).toBe(false)
    pcall(SendMail, "Zokk", "Hola", "")
    expect(f.last == nil).toBe(true)
    if SendMailFrame_Reset then
        SendMailFrame_Reset()
        expect(SendMailNameEditBox:GetText()).toBe("")
    end
end
