{
  "format": 1,
  "module": "EternityUI_Chat",
  "title": { "enUS": "Chat", "esES": "Chat" },
  "description": {
    "enUS": "The chat with the Eternity look: one window, tabs or a messenger, the sender's icon, level and class, and a saved history.",
    "esES": "El chat con el aspecto de Eternity: una ventana, pestañas o mensajería, el icono, nivel y clase de quien escribe, y un historial guardado."
  },
  "groups": [
    {
      "id": "mode",
      "label": { "enUS": "Mode", "esES": "Modo" },
      "options": [
        {
          "id": "style",
          "type": "select",
          "default": "tabs",
          "label": { "enUS": "How the chat is shown", "esES": "Cómo se muestra el chat" },
          "values": [
            { "value": "single", "label": { "enUS": "One window, no tabs", "esES": "Una ventana, sin pestañas" } },
            { "value": "tabs", "label": { "enUS": "Tabs", "esES": "Pestañas" } },
            { "value": "messenger", "label": { "enUS": "Messenger", "esES": "Mensajería" } }
          ],
          "description": {
            "enUS": "Messenger: conversations in their own window, like a messaging app. Loot and system stay in the normal chat.",
            "esES": "Mensajería: las conversaciones en su propia ventana, como una app de mensajes. Botín y sistema siguen en el chat."
          }
        },
        {
          "id": "whisperTabs",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Each whisper in its own tab", "esES": "Cada susurro en su propia pestaña" },
          "description": {
            "enUS": "Tabs mode only. It's Blizzard's whisper setting while this mode is on; it goes back to yours afterwards.",
            "esES": "Solo en el modo pestañas. Es el ajuste de susurros de Blizzard mientras este modo está activo; después vuelve al tuyo."
          }
        }
      ]
    },
    {
      "id": "messenger",
      "label": { "enUS": "Messenger", "esES": "Mensajería" },
      "options": [
        {
          "id": "whispers",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Whispers", "esES": "Susurros" }
        },
        {
          "id": "bnet",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Battle.net whispers", "esES": "Susurros de Battle.net" }
        },
        {
          "id": "guild",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Guild and officers", "esES": "Hermandad y oficiales" }
        },
        {
          "id": "group",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Party, raid and instance", "esES": "Grupo, banda e instancia" }
        },
        {
          "id": "say",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Say, yell and emotes", "esES": "Decir, gritar y emociones" }
        },
        {
          "id": "channels",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Channels", "esES": "Canales" }
        },
        {
          "id": "hideInChat",
          "type": "select",
          "default": "whispers",
          "label": { "enUS": "Remove from the normal chat", "esES": "Quitar del chat normal" },
          "values": [
            { "value": "none", "label": { "enUS": "Nothing", "esES": "Nada" } },
            { "value": "whispers", "label": { "enUS": "Whispers", "esES": "Los susurros" } },
            { "value": "all", "label": { "enUS": "Everything the messenger shows", "esES": "Todo lo que muestra la mensajería" } }
          ]
        },
        {
          "id": "autoOpen",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Open on a new whisper", "esES": "Abrir con un susurro nuevo" }
        },
        {
          "id": "sound",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Sound on a new whisper", "esES": "Sonido con un susurro nuevo" },
          "description": {
            "enUS": "The game's own whisper sound. The messenger takes whispers out of the normal chat, so the game doesn't play it then.",
            "esES": "El sonido de susurro del propio juego. La mensajería quita los susurros del chat normal, así que entonces el juego no lo reproduce."
          }
        },
        {
          "id": "soundOpen",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Also while reading that conversation", "esES": "También con esa conversación abierta" },
          "visibleWhen": { "messenger.sound": true }
        },
        {
          "id": "launcher",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Button on the chat", "esES": "Botón en el chat" },
          "description": {
            "enUS": "Opens the messenger and shows the unread count. /etchat also opens it.",
            "esES": "Abre la mensajería y muestra los no leídos. /etchat también la abre."
          }
        },
        {
          "id": "badge",
          "type": "select",
          "default": "whispers",
          "label": { "enUS": "Unread count on the chat button", "esES": "No leídos en el botón del chat" },
          "description": {
            "enUS": "Which conversations add to the number on the button (and its tooltip). Each conversation keeps its own count in the list.",
            "esES": "Qué conversaciones suman al número del botón (y a su tooltip). Cada conversación sigue con su propio contador en la lista."
          },
          "values": [
            { "value": "whispers", "label": { "enUS": "Whispers only (Battle.net too)", "esES": "Solo susurros (también de Battle.net)" } },
            { "value": "all", "label": { "enUS": "Everything in the messenger", "esES": "Todo lo de la mensajería" } },
            { "value": "none", "label": { "enUS": "No number", "esES": "Sin número" } }
          ],
          "visibleWhen": { "messenger.launcher": true }
        }
      ]
    },
    {
      "id": "names",
      "label": { "enUS": "Sender", "esES": "Quien escribe" },
      "options": [
        {
          "id": "icon",
          "type": "select",
          "default": "class",
          "label": { "enUS": "Icon", "esES": "Icono" },
          "values": [
            { "value": "none", "label": { "enUS": "None", "esES": "Ninguno" } },
            { "value": "class", "label": { "enUS": "Class", "esES": "Clase" } },
            { "value": "race", "label": { "enUS": "Race", "esES": "Raza" } }
          ]
        },
        {
          "id": "iconSize",
          "type": "range",
          "default": 14,
          "min": 10,
          "max": 24,
          "step": 1,
          "label": { "enUS": "Icon size", "esES": "Tamaño del icono" }
        },
        {
          "id": "level",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Level", "esES": "Nivel" },
          "description": {
            "enUS": "When it's known: group, guild, friends and players you've targeted or hovered. It's remembered for 30 days.",
            "esES": "Cuando se sabe: grupo, hermandad, amigos y jugadores que has seleccionado o señalado. Se recuerda 30 días."
          }
        },
        {
          "id": "levelColor",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Level colored by difficulty", "esES": "Nivel coloreado por dificultad" }
        },
        {
          "id": "classColor",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Name in its class color", "esES": "Nombre del color de su clase" }
        }
      ]
    },
    {
      "id": "history",
      "label": { "enUS": "History", "esES": "Historial" },
      "options": [
        {
          "id": "enabled",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Save the history", "esES": "Guardar el historial" },
          "description": {
            "enUS": "Messages sent during Blizzard's chat restrictions (encounters) aren't saved.",
            "esES": "Los mensajes de cuando Blizzard restringe el chat (encuentros) no se guardan."
          }
        },
        {
          "id": "scope",
          "type": "select",
          "default": "character",
          "label": { "enUS": "Saved for", "esES": "Guardado para" },
          "values": [
            { "value": "character", "label": { "enUS": "Each character", "esES": "Cada personaje" } },
            { "value": "account", "label": { "enUS": "The whole account", "esES": "Toda la cuenta" } }
          ]
        },
        {
          "id": "whispers",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Whispers", "esES": "Susurros" }
        },
        {
          "id": "bnet",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Battle.net whispers", "esES": "Susurros de Battle.net" }
        },
        {
          "id": "guild",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Guild and officers", "esES": "Hermandad y oficiales" }
        },
        {
          "id": "group",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Party, raid and instance", "esES": "Grupo, banda e instancia" }
        },
        {
          "id": "say",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Say, yell and emotes", "esES": "Decir, gritar y emociones" }
        },
        {
          "id": "channels",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Channels", "esES": "Canales" }
        },
        {
          "id": "lines",
          "type": "range",
          "default": 200,
          "min": 20,
          "max": 1000,
          "step": 10,
          "label": { "enUS": "Lines per conversation", "esES": "Líneas por conversación" }
        },
        {
          "id": "days",
          "type": "range",
          "default": 14,
          "min": 1,
          "max": 90,
          "step": 1,
          "label": { "enUS": "Days to keep", "esES": "Días que se guarda" }
        },
        {
          "id": "restore",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show it again in the chat on login", "esES": "Volver a mostrarlo en el chat al entrar" }
        },
        {
          "id": "restoreLines",
          "type": "range",
          "default": 30,
          "min": 5,
          "max": 200,
          "step": 5,
          "label": { "enUS": "Lines shown again", "esES": "Líneas que se vuelven a mostrar" }
        }
      ]
    },
    {
      "id": "copy",
      "label": { "enUS": "Copy chat", "esES": "Copiar el chat" },
      "options": [
        {
          "id": "button",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Copy button on each chat window", "esES": "Botón de copiar en cada ventana del chat" },
          "description": {
            "enUS": "Opens the window's text in a box to copy it (Ctrl+A, Ctrl+C), without colors or icons. /etchat copy also does. Protected lines show as (protected).",
            "esES": "Abre el texto de la ventana en una caja para copiarlo (Ctrl+A, Ctrl+C), sin colores ni iconos. /etchat copy también lo hace. Las líneas protegidas salen como (protegido)."
          }
        }
      ]
    },
    {
      "id": "text",
      "tab": "appearance",
      "label": { "enUS": "Text", "esES": "Texto" },
      "options": [
        {
          "id": "font",
          "type": "select",
          "default": "theme",
          "label": { "enUS": "Font", "esES": "Fuente" },
          "values": [
            { "value": "theme", "label": { "enUS": "The theme's", "esES": "La del tema" } },
            { "value": "blizzard", "label": { "enUS": "Blizzard's", "esES": "La de Blizzard" } }
          ]
        },
        {
          "id": "size",
          "type": "range",
          "default": 14,
          "min": 8,
          "max": 24,
          "step": 1,
          "label": { "enUS": "Text size", "esES": "Tamaño del texto" }
        },
        {
          "id": "outline",
          "type": "select",
          "default": "none",
          "label": { "enUS": "Outline", "esES": "Contorno" },
          "values": [
            { "value": "none", "label": { "enUS": "None", "esES": "Ninguno" } },
            { "value": "OUTLINE", "label": { "enUS": "Thin", "esES": "Fino" } },
            { "value": "THICKOUTLINE", "label": { "enUS": "Thick", "esES": "Grueso" } }
          ]
        },
        {
          "id": "shadow",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Text shadow", "esES": "Sombra del texto" }
        }
      ]
    },
    {
      "id": "background",
      "tab": "appearance",
      "label": { "enUS": "Background", "esES": "Fondo" },
      "options": [
        {
          "id": "style",
          "type": "select",
          "default": "eternity",
          "label": { "enUS": "Background", "esES": "Fondo" },
          "values": [
            { "value": "eternity", "label": { "enUS": "Eternity", "esES": "Eternity" } },
            { "value": "blizzard", "label": { "enUS": "Blizzard's", "esES": "El de Blizzard" } },
            { "value": "none", "label": { "enUS": "None", "esES": "Ninguno" } }
          ]
        },
        {
          "id": "opacity",
          "type": "range",
          "default": 0.75,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Opacity", "esES": "Opacidad" },
          "description": {
            "enUS": "Of the chat's background and of the input box while you're not typing. 0: only the text is left.",
            "esES": "Del fondo del chat y de la caja de texto mientras no escribes. 0: solo queda el texto."
          },
          "visibleWhen": { "background.style": "eternity" }
        },
        {
          "id": "combatFade",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Lighter background in combat", "esES": "Fondo más tenue en combate" },
          "description": {
            "enUS": "In combat the chat's background (and its image) fades to the opacity below, for a cleaner screen. The messages stay.",
            "esES": "En combate el fondo del chat (y su imagen) baja a la opacidad de abajo, para ver la pantalla más limpia. Los mensajes se quedan."
          },
          "visibleWhen": { "background.style": "eternity" }
        },
        {
          "id": "combatOpacity",
          "type": "range",
          "default": 0.15,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Background opacity in combat", "esES": "Opacidad del fondo en combate" },
          "description": {
            "enUS": "Of the background as it is out of combat: 0 hides it, 1 leaves it as it is.",
            "esES": "Respecto al fondo fuera de combate: 0 lo oculta, 1 lo deja igual."
          },
          "visibleWhen": { "background.combatFade": true }
        },
        {
          "id": "border",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Border", "esES": "Borde" },
          "visibleWhen": { "background.style": "eternity" }
        },
        {
          "id": "shadow",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Window shadow", "esES": "Sombra de la ventana" },
          "description": {
            "enUS": "The soft shadow around the chat. The text's shadow is under Text.",
            "esES": "La sombra difuminada alrededor del chat. La sombra de las letras está en Texto."
          },
          "visibleWhen": { "background.style": "eternity" }
        },
        {
          "id": "padding",
          "type": "range",
          "default": 6,
          "min": 0,
          "max": 16,
          "step": 1,
          "label": { "enUS": "Margin around the text", "esES": "Margen alrededor del texto" },
          "visibleWhen": { "background.style": "eternity" }
        }
      ]
    },
    {
      "id": "tabs",
      "tab": "appearance",
      "label": { "enUS": "Tabs", "esES": "Pestañas" },
      "options": [
        {
          "id": "style",
          "type": "select",
          "default": "pill",
          "label": { "enUS": "Style", "esES": "Estilo" },
          "values": [
            { "value": "pill", "label": { "enUS": "Pill", "esES": "Píldora" } },
            { "value": "underline", "label": { "enUS": "Underline", "esES": "Subrayado" } },
            { "value": "blizzard", "label": { "enUS": "Blizzard's", "esES": "Las de Blizzard" } }
          ]
        },
        {
          "id": "size",
          "type": "range",
          "default": 12,
          "min": 9,
          "max": 18,
          "step": 1,
          "label": { "enUS": "Text size", "esES": "Tamaño del texto" }
        }
      ]
    },
    {
      "id": "editBox",
      "tab": "appearance",
      "label": { "enUS": "Input box", "esES": "Caja de texto" },
      "options": [
        {
          "id": "style",
          "type": "select",
          "default": "eternity",
          "label": { "enUS": "Style", "esES": "Estilo" },
          "values": [
            { "value": "eternity", "label": { "enUS": "Eternity", "esES": "Eternity" } },
            { "value": "blizzard", "label": { "enUS": "Blizzard's", "esES": "La de Blizzard" } },
            { "value": "none", "label": { "enUS": "None (text only)", "esES": "Ninguna (solo el texto)" } }
          ]
        },
        {
          "id": "position",
          "type": "select",
          "default": "bottom",
          "label": { "enUS": "Position", "esES": "Posición" },
          "values": [
            { "value": "bottom", "label": { "enUS": "Below the chat", "esES": "Debajo del chat" } },
            { "value": "top", "label": { "enUS": "Above the chat", "esES": "Encima del chat" } }
          ]
        }
      ]
    },
    {
      "id": "buttons",
      "tab": "appearance",
      "label": { "enUS": "Blizzard buttons", "esES": "Botones de Blizzard" },
      "options": [
        {
          "id": "menu",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Chat menu", "esES": "Menú del chat" }
        },
        {
          "id": "channels",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Channels and voice", "esES": "Canales y voz" }
        },
        {
          "id": "social",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Social and quick join", "esES": "Social y unión rápida" }
        },
        {
          "id": "speech",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Text to speech", "esES": "Texto a voz" }
        },
        {
          "id": "side",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Side bar of each window", "esES": "Barra lateral de cada ventana" }
        },
        {
          "id": "socialPosition",
          "type": "select",
          "default": "blizzard",
          "label": { "enUS": "Social button position", "esES": "Posición del botón social" },
          "description": {
            "enUS": "The friends and quick join button, with the chat's other alerts.",
            "esES": "El botón de amigos y unión rápida, junto con los demás avisos del chat."
          },
          "values": [
            { "value": "blizzard", "label": { "enUS": "Where Blizzard puts it", "esES": "Donde lo pone Blizzard" } },
            { "value": "above", "label": { "enUS": "Above the chat", "esES": "Encima del chat" } },
            { "value": "left", "label": { "enUS": "Left of the chat", "esES": "A la izquierda del chat" } },
            { "value": "right", "label": { "enUS": "Right of the chat", "esES": "A la derecha del chat" } }
          ]
        },
        {
          "id": "socialX",
          "type": "range",
          "default": 0,
          "min": -200,
          "max": 200,
          "step": 1,
          "label": { "enUS": "Social button: horizontal offset", "esES": "Botón social: desplazamiento horizontal" },
          "visibleWhen": { "buttons.socialPosition": ["above", "left", "right"] }
        },
        {
          "id": "socialY",
          "type": "range",
          "default": 0,
          "min": -200,
          "max": 200,
          "step": 1,
          "label": { "enUS": "Social button: vertical offset", "esES": "Botón social: desplazamiento vertical" },
          "visibleWhen": { "buttons.socialPosition": ["above", "left", "right"] }
        }
      ]
    },
    {
      "id": "window",
      "tab": "appearance",
      "label": { "enUS": "Messenger window", "esES": "Ventana de mensajería" },
      "options": [
        {
          "id": "width",
          "type": "range",
          "default": 640,
          "min": 420,
          "max": 1400,
          "step": 10,
          "label": { "enUS": "Width", "esES": "Ancho" }
        },
        {
          "id": "height",
          "type": "range",
          "default": 460,
          "min": 300,
          "max": 1000,
          "step": 10,
          "label": { "enUS": "Height", "esES": "Alto" }
        },
        {
          "id": "listWidth",
          "type": "range",
          "default": 220,
          "min": 150,
          "max": 400,
          "step": 5,
          "label": { "enUS": "Conversation list width", "esES": "Ancho de la lista de conversaciones" }
        },
        {
          "id": "scale",
          "type": "range",
          "default": 1,
          "min": 0.5,
          "max": 2,
          "step": 0.05,
          "label": { "enUS": "Scale", "esES": "Escala" }
        },
        {
          "id": "opacity",
          "type": "range",
          "default": 1,
          "min": 0.2,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Background opacity", "esES": "Opacidad del fondo" }
        },
        {
          "id": "alpha",
          "type": "range",
          "default": 1,
          "min": 0.1,
          "max": 1,
          "step": 0.05,
          "label": { "enUS": "Window opacity", "esES": "Opacidad de la ventana" },
          "description": {
            "enUS": "Of the whole window: background, conversations and texts.",
            "esES": "De toda la ventana: fondo, conversaciones y textos."
          }
        }
      ]
    },
    {
      "id": "bubbles",
      "tab": "appearance",
      "label": { "enUS": "Messenger bubbles", "esES": "Burbujas de la mensajería" },
      "options": [
        {
          "id": "mine",
          "type": "select",
          "default": "accent",
          "label": { "enUS": "My messages", "esES": "Mis mensajes" },
          "values": [
            { "value": "accent", "label": { "enUS": "Accent color", "esES": "Color de acento" } },
            { "value": "custom", "label": { "enUS": "Custom color", "esES": "Color propio" } }
          ]
        },
        {
          "id": "mineColor",
          "type": "color",
          "default": "#2F8F5B",
          "label": { "enUS": "Custom color for mine", "esES": "Color propio de los míos" }
        },
        {
