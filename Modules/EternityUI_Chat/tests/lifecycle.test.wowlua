-- The module starts, stops and files messages.
import test, expect from "wowlua:test"

local NAME = "EternityUI_Chat"

@test("the module starts")
local function starts()
    expect(EternityUI:GetModule(NAME).active).toBe(true)
end

@test("the module stops and starts again")
local function cycle()
    EternityUI.store:SetModuleEnabled(NAME, false)
    expect(EternityUI:GetModule(NAME).active).toBe(false)
    EternityUI.store:SetModuleEnabled(NAME, true)
    expect(EternityUI:GetModule(NAME).active).toBe(true)
end

@test("the chat's background gets lighter in combat, if that option is on")
local function chatCombat()
    local skin = EternityUI:GetModule("EternityUI_Chat").ns.Skin
    local frame = ChatFrame1
    if not (skin and skin.decor and skin.decor[frame]) then
        return
    end
    local store = EternityUI.store
    store:Set("EternityUI_Chat", "background.combatFade", true)
    store:Set("EternityUI_Chat", "background.combatOpacity", 0.3)
    local fight = UnitAffectingCombat
    ---@type any
    local inCombat = function()
        return true
    end
    UnitAffectingCombat = inCombat
    skin:ApplyCombat(frame)
    UnitAffectingCombat = fight
    expect(math.floor(skin.decor[frame]:GetAlpha() * 100 + 0.5)).toBe(30)
    skin:ApplyCombat(frame)
    expect(skin.decor[frame]:GetAlpha()).toBe(1)
    store:Set("EternityUI_Chat", "background.combatFade", false)
end

@test("leaving combat goes over every skinned part without error (tabs and the input box too)")
local function combatEveryPart()
    local skin = EternityUI:GetModule("EternityUI_Chat").ns.Skin
    if not (skin and skin.decor) then
        return
    end
    local plain = 0
    for part, decor in pairs(skin.decor) do
        if not decor.wallpaper then
            plain = plain + 1
        end
        local ok, err = pcall(skin.ApplyCombat, skin, part)
        expect(ok).toBe(true)
        if not ok then
            print(err)
        end
    end
    -- The tabs' look is there too: the case that errored.
    expect(plain > 0).toBe(true)
end

local function messengerWith(name)
    local ns = EternityUI:GetModule("EternityUI_Chat").ns
    EternityUI.store:Set("EternityUI_Chat", "mode.style", "messenger")
    local conversation = ns.History:Conversation("w:" .. name, "whisper", name, name)
    ns.Messenger:Open(conversation.key)
    return ns.Messenger, conversation
end

@test("a shift-click link goes in the messenger's box while writing there")
local function messengerLinks()
    local messenger = messengerWith("Linkfriend")
    local w = messenger.frame
    local link = "|cff0070dd|Hitem:6948::::::::60:::::::::|h[Hearthstone]|h|r"
    w.input:SetText("look: ")
    w.input:SetFocus()
    ChatFrameUtil.InsertLink(link)
    expect(w.input:GetText()).toBe("look: " .. link)
    -- Not written in: the link isn't taken.
    w.input:ClearFocus()
    w.input:SetText("")
    ChatFrameUtil.InsertLink(link)
    expect(w.input:GetText()).toBe("")
    w:Hide()
    EternityUI.store:Set("EternityUI_Chat", "mode.style", "tabs")
end

@test("a new whisper plays the game's sound, also with its conversation open if the option says so")
local function whisperSound()
    local messenger, conversation = messengerWith("Soundfriend")
    local store = EternityUI.store
    local played = 0
    local playSound = PlaySound
    ---@type any
    local count = function(kit)
        if kit == SOUNDKIT.TELL_MESSAGE then
            played = played + 1
        end
    end
    PlaySound = count
    store:Set("EternityUI_Chat", "messenger.sound", true)
    store:Set("EternityUI_Chat", "messenger.soundOpen", true)
    messenger:OnMessage(conversation, { t = time(), text = "hi" })
    store:Set("EternityUI_Chat", "messenger.soundOpen", false)
    messenger:OnMessage(conversation, { t = time(), text = "hi again" })
    store:Set("EternityUI_Chat", "messenger.sound", false)
    messenger.frame:Hide()
    messenger:OnMessage(conversation, { t = time(), text = "and again" })
    PlaySound = playSound
    store:Set("EternityUI_Chat", "messenger.sound", true)
    store:Set("EternityUI_Chat", "messenger.soundOpen", true)
    store:Set("EternityUI_Chat", "mode.style", "tabs")
    expect(played).toBe(1)
end

