{
  "format": 1,
  "module": "EternityUI_TargetDebuffs",
  "title": { "enUS": "Target debuffs", "esES": "Perjuicios del objetivo" },
  "description": {
    "enUS": "The target's debuffs in a frame of their own, placed with the Mover. The game filters them, so it works in combat too. The Spells tab keeps your own list of spell IDs to show first, whoever cast them or only yours.",
    "esES": "Los perjuicios del objetivo en un marco propio, colocado con el Mover. Los filtra el propio juego, así que funciona también en combate. La pestaña Hechizos guarda tu lista de números de hechizo que salen primero, los ponga quien los ponga o solo los tuyos."
  },
  "groups": [
    {
      "id": "show",
      "label": { "enUS": "What to show", "esES": "Qué mostrar" },
      "options": [
        {
          "id": "origin",
          "type": "select",
          "default": "all",
          "label": { "enUS": "Cast by", "esES": "Puestos por" },
          "values": [
            { "value": "all", "label": { "enUS": "Anyone", "esES": "Cualquiera" } },
            { "value": "mine", "label": { "enUS": "Me (and my pet)", "esES": "Mí (y mi mascota)" } },
            { "value": "others", "label": { "enUS": "Others", "esES": "Otros" } }
          ]
        },
        {
          "id": "crowdControl",
          "type": "select",
          "default": "show",
          "label": { "enUS": "Crowd control", "esES": "Control de masas" },
          "description": {
            "enUS": "Stuns, fears, roots, polymorphs...",
            "esES": "Aturdimientos, miedos, raíces, polimorfias..."
          },
          "values": [
            { "value": "show", "label": { "enUS": "Show", "esES": "Mostrar" } },
            { "value": "hide", "label": { "enUS": "Hide", "esES": "Ocultar" } },
            { "value": "only", "label": { "enUS": "Only crowd control", "esES": "Solo control de masas" } }
          ]
        },
        {
          "id": "dispellable",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Only dispellable ones", "esES": "Solo los que se pueden disipar" }
        },
        {
          "id": "sort",
          "type": "select",
          "default": "expiration",
          "label": { "enUS": "Order", "esES": "Orden" },
          "values": [
            { "value": "expiration", "label": { "enUS": "Mine first, then the ones ending soonest", "esES": "Los míos primero y luego los que acaban antes" } },
            { "value": "default", "label": { "enUS": "Mine first, then as they were cast", "esES": "Los míos primero y luego según se pusieron" } },
            { "value": "name", "label": { "enUS": "Mine first, then by name", "esES": "Los míos primero y luego por nombre" } }
          ]
        },
        { "id": "max", "type": "range", "default": 16, "min": 1, "max": 40, "step": 1, "label": { "enUS": "Most debuffs shown", "esES": "Máximo de perjuicios" } },
        {
          "id": "inCombatOnly",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Only in combat", "esES": "Solo en combate" }
        }
      ]
    },
    {
      "id": "frame",
      "label": { "enUS": "Frame", "esES": "Marco" },
      "options": [
        {
          "id": "scale",
          "type": "range",
          "default": 1,
          "min": 0.5,
          "max": 3,
          "step": 0.05,
          "label": { "enUS": "Zoom", "esES": "Zoom" },
          "description": {
            "enUS": "Makes the whole frame bigger or smaller. Its place is set with the Mover (Spells tab > Place the frame, or /et move).",
            "esES": "Hace todo el marco más grande o más pequeño. Su sitio se elige con el Mover (pestaña Hechizos > Colocar el marco, o /et move)."
          }
        },
        { "id": "durationText", "type": "toggle", "default": true, "label": { "enUS": "Time left as text", "esES": "Tiempo restante en texto" } },
        { "id": "swipe", "type": "toggle", "default": true, "label": { "enUS": "Time left as a shadow", "esES": "Tiempo restante como sombra" } },
        { "id": "dispelBorder", "type": "toggle", "default": true, "label": { "enUS": "Border in the debuff type's color", "esES": "Borde del color del tipo de perjuicio" } }
      ]
    },
    {
      "id": "look",
      "tab": "appearance",
      "label": { "enUS": "Icons", "esES": "Iconos" },
      "options": [
        { "id": "size", "type": "range", "default": 30, "min": 16, "max": 64, "step": 1, "label": { "enUS": "Size", "esES": "Tamaño" } },
        { "id": "spacing", "type": "range", "default": 4, "min": 0, "max": 16, "step": 1, "label": { "enUS": "Spacing", "esES": "Separación" } },
        { "id": "perRow", "type": "range", "default": 8, "min": 1, "max": 20, "step": 1, "label": { "enUS": "Icons per row", "esES": "Iconos por fila" } },
        {
          "id": "growth",
          "type": "select",
          "default": "right",
          "label": { "enUS": "They grow", "esES": "Crecen hacia" },
          "values": [
            { "value": "right", "label": { "enUS": "To the right", "esES": "La derecha" } },
            { "value": "left", "label": { "enUS": "To the left", "esES": "La izquierda" } }
          ]
        },
        {
          "id": "wrap",
          "type": "select",
          "default": "down",
          "label": { "enUS": "New rows go", "esES": "Las filas nuevas van" },
          "values": [
            { "value": "down", "label": { "enUS": "Below", "esES": "Debajo" } },
            { "value": "up", "label": { "enUS": "Above", "esES": "Encima" } }
          ]
        },
        { "id": "textSize", "type": "range", "default": 11, "min": 8, "max": 20, "step": 1, "label": { "enUS": "Time text size", "esES": "Tamaño del texto del tiempo" } },
        { "id": "countSize", "type": "range", "default": 12, "min": 8, "max": 20, "step": 1, "label": { "enUS": "Stacks text size", "esES": "Tamaño del texto de las cargas" } }
      ]
    }
  ]
}
