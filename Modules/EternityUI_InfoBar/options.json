{
  "format": 1,
  "module": "EternityUI_InfoBar",
  "title": { "enUS": "Info bar", "esES": "Barra de información" },
  "description": {
    "enUS": "A small bar with the time, FPS, latency and gold. Move it with the Mover; click it to open these options, right click for the Performance tab: where the FPS go.",
    "esES": "Una barra pequeña con la hora, los FPS, la latencia y el oro. Muévela con el Mover; haz clic para abrir estas opciones y clic derecho para la pestaña Rendimiento: a dónde se van los FPS."
  },
  "groups": [
    {
      "id": "content",
      "label": { "enUS": "Content", "esES": "Contenido" },
      "options": [
        {
          "id": "clock",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show the time", "esES": "Mostrar la hora" }
        },
        {
          "id": "clockFormat",
          "type": "select",
          "default": "24h",
          "label": { "enUS": "Time format", "esES": "Formato de la hora" },
          "values": [
            { "value": "24h", "label": { "enUS": "24-hour (18:30)", "esES": "24 horas (18:30)" } },
            { "value": "12h", "label": { "enUS": "12-hour (6:30 PM)", "esES": "12 horas (6:30 PM)" } }
          ]
        },
        {
          "id": "fps",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show FPS", "esES": "Mostrar los FPS" }
        },
        {
          "id": "latency",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show latency", "esES": "Mostrar la latencia" }
        },
        {
          "id": "gold",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show gold", "esES": "Mostrar el oro" }
        },
        {
          "id": "separator",
          "type": "text",
          "default": "·",
          "maxLength": 8,
          "label": { "enUS": "Separator", "esES": "Separador" },
          "description": {
            "enUS": "Text between items. Empty leaves just a gap.",
            "esES": "Texto entre los elementos. Vacío deja solo un hueco."
          }
        }
      ]
    },
    {
      "id": "alerts",
      "label": { "enUS": "Alerts", "esES": "Avisos" },
      "options": [
        {
          "id": "lowFps",
          "type": "range",
          "default": 30,
          "min": 5,
          "max": 120,
          "step": 5,
          "label": { "enUS": "Low FPS below", "esES": "FPS bajos por debajo de" }
        },
        {
          "id": "highLatency",
          "type": "range",
          "default": 200,
          "min": 50,
          "max": 1000,
          "step": 10,
          "label": { "enUS": "High latency above (ms)", "esES": "Latencia alta por encima de (ms)" }
        },
        {
          "id": "color",
          "type": "color",
          "default": "#F87171",
          "label": { "enUS": "Alert color", "esES": "Color de aviso" }
        }
      ]
    },
    {
      "id": "layout",
      "tab": "appearance",
      "label": { "enUS": "Look", "esES": "Aspecto" },
      "options": [
        {
          "id": "scale",
          "type": "range",
          "default": 1,
          "min": 0.6,
          "max": 2,
          "step": 0.05,
          "label": { "enUS": "Scale", "esES": "Escala" }
        },
        {
          "id": "background",
          "type": "toggle",
          "default": true,
          "label": { "enUS": "Show the background", "esES": "Mostrar el fondo" }
        },
        {
          "id": "accentValues",
          "type": "toggle",
          "default": false,
          "label": { "enUS": "Values in the accent color", "esES": "Valores en el color de acento" }
        }
      ]
    }
  ]
}
